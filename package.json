{
  "name": "gif-to-sprite-player",
  "version": "1.0.0",
  "description": "A Vue 3 component for playing GIFs as sprite sheets.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "bun run build && bun run license:gen",
    "license:gen": "npx license-checker --production --markdown > THIRD_PARTY_LICENSES.md",
    "license:check": "npx license-checker --production --summary"
  },
  "keywords": ["vue", "gif", "sprite", "player", "vue3"],
  "author": "littletree71",
  "license": "MIT",
  "dependencies": {
    "@panzoom/panzoom": "^4.6.0",
    "gifuct-js": "^2.1.2",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "vite-plugin-static-copy": "^2.3.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
